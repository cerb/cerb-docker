CERB_ENV=docker
CERB_VERSION=12.0
CERB_HOSTNAME=localhost
CERB_PORT=80
CERB_PORT_SSL=443
CERB_INSTALL=yes
CERB_SERVICE_TOKEN=s3cr3t
CERB_SERVICE_TOKEN_SCOPE="cron update"
#CERB_PROXY_HOST=squid
#CERB_PROXY_PORT=3128

# PHP-FPM children per container. `www` is sized on CPU and memory;
# `background` on memory and DB connections, since a drain worker waits on
# curl rather than burning CPU. Prefer `--scale cerb-background=N` over a
# large child count.
CERB_WEB_CHILDREN=6
CERB_BACKGROUND_CHILDREN=4

# Where Caddy sends /queue and /cron. Set this to `cerb:9000` to collapse
# the split back onto a single pool.
#CERB_FPM_BACKGROUND=cerb-background:9000

MYSQL_VERSION=8.4
MYSQL_HOST=mysql
MYSQL_DATABASE=cerb
MYSQL_USER=cerb
MYSQL_PASSWORD=s3cr3t

CADDY_VERSION=latest
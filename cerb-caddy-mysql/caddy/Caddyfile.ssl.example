## Example Caddyfile for serving Cerb over HTTPS.
##
## To use, copy this file over `Caddyfile` and restart the `caddy`
## container. For a publicly-resolvable hostname Caddy will obtain a
## certificate from Let's Encrypt automatically. For local development
## Caddy will fall back to its internal self-signed CA (which produces
## browser warnings unless you trust Caddy's root CA on your machine).

{
    # Comment this out in production to allow HTTP->HTTPS redirects.
    auto_https disable_redirects

    log {
    	level INFO
    	output stdout
    }
}

:80 {
	@notACME {
	    not path /.well-known/acme-challenge/*
	}
    redir @notACME https://{$CERB_HOSTNAME}:{$CERB_PORT_SSL}{uri}
}

{$CERB_HOSTNAME} {
	header -Server

	request_body {
		max_size 32MB
	}

    root * /var/www/html

    @install_disabled {
    	expression {env.CERB_INSTALL} != "yes"
    	path_regexp ^/install/index\.php($|/.*)
    }

    rewrite @install_disabled /index.php

    route {
    	@rewritePaths {
		 	not path_regexp ^/(index\.php|ajax\.php|install/index\.php)($|/.*)
    	}

    	rewrite @rewritePaths /index.php{uri}

    	reverse_proxy * cerb:9000 {
    		transport fastcgi {
    			split .php
    		}
    	}
    }
}
